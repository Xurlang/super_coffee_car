<launch>
  <include file="$(find super_coffee_car_navigation)/launch/super_coffee_car_navigation.launch">
      <arg name="map_file" value="$(find super_coffee_car_navigation)/maps/nav_map/map.yaml"/> 
      <arg name="open_rviz" value="false"/> 
  </include>

  <group ns="mapping">
    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
        
        <remap from="scan" to="/scan"/>
        
        <param name="transform_publish_period" value="0"/> 
        
        <param name="base_frame" value="base_footprint"/>
        <param name="odom_frame" value="odom"/> 
        <param name="map_frame"  value="new_map"/> 
        
        <rosparam command="load" file="$(find super_coffee_car_slam)/config/gmapping_params.yaml" />
    </node>
  </group>

  <node pkg="rviz" type="rviz" name="rviz" required="true"
      args="-d $(find super_coffee_car_navigation)/rviz/nav.rviz"/>

</launch>