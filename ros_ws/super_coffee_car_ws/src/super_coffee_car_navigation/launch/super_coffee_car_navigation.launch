<launch>
  <arg name="map_file" default="$(find super_coffee_car_navigation)/maps/nav_map/map.yaml"/>
  <arg name="open_rviz" default="true"/>
  <arg name="move_forward_only" default="false"/>

  <node pkg="map_server" name="map_server" type="map_server" args="$(arg map_file)"/>

  <include file="$(find turtlebot3_navigation)/launch/amcl.launch">
    <arg name="initial_pose_x" value="0.31875"/>
    
    <arg name="initial_pose_y" value="-4.28907"/>
    
    <arg name="initial_pose_a" value="0.0"/>
  </include>

  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    
    <rosparam file="$(find super_coffee_car_navigation)/param/costmap_common_params_waffle_pi.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find super_coffee_car_navigation)/param/costmap_common_params_waffle_pi.yaml" command="load" ns="local_costmap" />
    
    <rosparam file="$(find super_coffee_car_navigation)/param/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find super_coffee_car_navigation)/param/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find super_coffee_car_navigation)/param/move_base_params.yaml" command="load" />
    
    <rosparam file="$(find super_coffee_car_navigation)/param/teb_local_planner_params.yaml" command="load" />
    
    <remap from="cmd_vel" to="/cmd_vel"/>
    <remap from="odom" to="/odom"/>
  </node>

  <group if="$(arg open_rviz)"> 
    <node pkg="rviz" type="rviz" name="rviz" required="true"
          args="-d $(find turtlebot3_navigation)/rviz/turtlebot3_navigation.rviz"/>
  </group>
</launch>